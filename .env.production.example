# Production build settings for the Lead360 operator console.
#
# Copy to `.env.production` (gitignored) or set these in the build environment.
# None of these are secrets — they are public endpoints baked into the bundle,
# which is exactly why they must be correct: whatever is here ships to every
# browser that loads the console.
#
# The build FAILS if VITE_API_BASE_URL is missing. That is deliberate. Vite
# substitutes these literally, and `env.ts` casts the result to string, so an
# unset value produces a bundle calling `undefined/...` on every request — an
# app that loads, renders, and shows an error in every panel. It looks like the
# API is down. There is no safe default either: guessing localhost is how a
# deployed console ends up pointing at somebody's laptop.

# Which product this build is the console for: `lead360` (default) or
# `stylemint`. One codebase, two outputs.
#
# Leave it unset for the Lead360 chatbot CRM console — that is the default and
# what every existing build already produces.
#
# Set it to `stylemint` for the StyleMint commerce operator console. That build
# hides the bot/CRM navigation, wears StyleMint's name, and drops the chatbot
# marketing landing page from `/` — the page is left out of the bundle, not
# merely off the screen, so the branch below must stay a literal comparison in
# `route-table.tsx` for the build to fold it away.
#
# Build it with the base path the console is served under, e.g.
#   VITE_CONSOLE_PRODUCT=stylemint npm run build -- --base=/console/
# VITE_CONSOLE_PRODUCT=stylemint

# The deployed API origin, including any path prefix the gateway expects.
# This is what the retired stack served and what the cutover preserves.
VITE_API_BASE_URL=https://stylemint.voyageritnepal.com/api

# SignalR hub origin. Leave blank to fall back to the API origin.
VITE_WS_URL=

# Mock Service Worker — must stay false outside local development. Turning it
# on in a deployed build serves fabricated responses to real operators.
VITE_ENABLE_MSW=false

# Optional. Absent means no crash reporting, which is a choice, not a default.
VITE_SENTRY_DSN=
